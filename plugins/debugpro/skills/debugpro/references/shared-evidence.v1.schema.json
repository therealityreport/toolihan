{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/shared-evidence.v1.json",
  "title": "Shared Evidence Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "sourcePlugin", "findingId", "severity", "claim", "evidence", "affectedFiles", "recommendedNextStep", "status"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "sourcePlugin": { "type": "string", "enum": ["plan-grader", "debugpro", "comprehensive-review", "chrome-devtools", "tool-finder"] },
    "findingId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "severity": { "type": "string", "enum": ["blocker", "critical", "high", "medium", "low", "info"] },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary"],
        "properties": {
          "kind": { "type": "string", "enum": ["file", "command", "log", "test", "runtime", "screenshot", "url", "note"] },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "command": { "type": "string" },
          "redacted": { "type": "boolean", "default": true }
        }
      }
    },
    "affectedFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "recommendedNextStep": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["open", "accepted", "deferred", "resolved", "rejected"] }
  }
}
